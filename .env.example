ZHISHIKU_DEBUG=0
ZHISHIKU_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Set these in the environment; this file is an example, not automatically loaded.
# ZHISHIKU_SECRET_KEY=generate-an-independent-secret
# ZHISHIKU_DATA_ROOT=D:/Zhishiku/ZhiShi
# ZHISHIKU_MEDIA_ROOT=D:/Zhishiku/media
# ZHISHIKU_DB_PATH=D:/Zhishiku/db.sqlite3
# ZHISHIKU_NETWORK_MODE=1  # HTTPS proxy required, see docs/OPERATIONS.md
# ZHISHIKU_ALLOW_PRIVATE_FETCH=0
# Cloud material transfer is disabled by default. The admin settings page can enable it.
# ZHISHIKU_ALLOW_AI_OUTBOUND=1
# Provider fallback is disabled by default; enabling it sends material to other enabled providers.
# ZHISHIKU_AI_ALLOW_FALLBACK=1
# ZHISHIKU_UPLOAD_MAX_BYTES=67108864
# ZHISHIKU_BACKUP_MAX_BYTES=8589934592
# ZHISHIKU_BACKUP_ROOT=D:/Zhishiku/backups
